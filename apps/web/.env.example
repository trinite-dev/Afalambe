# Web origin (used for absolute links). Dev is pinned to port 3002.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# --- Backend mode (feat-0047) ---
# Default: same-origin Next.js API at /api/trpc (omit NEXT_PUBLIC_API_URL).
# Dual-run rollback: point at standalone apps/api instead:
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: max image size in bytes (default 5242880 = 5 MiB)
# NEXT_PUBLIC_CHAT_IMAGE_MAX_BYTES=5242880

# Never expose AI provider keys to the browser (no NEXT_PUBLIC_OPENAI_*).
# Transcription uses server AI_API_KEY via claim.transcribeAudio.

# Set to "false" to show demo-unavailable page instead of /demo
# NEXT_PUBLIC_DEMO_ENABLED=true

# --- Server secrets (required when using /api/trpc on Next) ---
# Copy from apps/api/.env for local same-origin mode. Never commit real values.
# DATABASE_URL=
# DIRECT_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET_CHAT_UPLOADS=chat-uploads
# CHAT_IMAGE_MAX_BYTES=5242880
# CHAT_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp
# AUTH_COOKIE_NAME=afalambe_session
# AUTH_COOKIE_SECURE=false
# RESEND_API_KEY=
# EMAIL_FROM=beth.t@example.com
# RESEND_WEBHOOK_SIGNING_SECRET=
# AI_PROVIDER=gemini
# AI_MODEL=gemini-flash-latest
# AI_API_KEY=
# CRON_SECRET=replace-with-strong-secret
# EMAIL_DEV_LOG_OTP=true
# EMAIL_DEV_EXPOSE_OTP=true
