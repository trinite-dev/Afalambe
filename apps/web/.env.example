# Web origin (used for absolute links). Dev is pinned to port 3002.
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: max image size in bytes (default 5242880 = 5 MiB)
# NEXT_PUBLIC_CHAT_IMAGE_MAX_BYTES=5242880

# Set to "false" to show demo-unavailable page instead of /demo
# NEXT_PUBLIC_DEMO_ENABLED=true
