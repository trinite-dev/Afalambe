API_PORT=4000
# Primary web origin (used for email links and as a CORS allowlist entry)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional comma-separated extra browser origins (Next may use :3001 if :3000 is taken)
# CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Localhost :3000 and :3001 are always allowed in development CORS.
# Runtime: Supabase "Transaction" pooler (port 6543). Encode @ in passwords as %40.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations: Supabase "Direct" connection (db.*.supabase.co:5432)
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase Storage: allow PUT from your web origin on bucket chat-uploads
# Dashboard -> Storage -> bucket -> Configuration -> CORS
# Example: allowed origins http://localhost:3000, methods PUT GET HEAD, headers *
# AI: openai | gemini (google)
AI_PROVIDER=gemini
AI_MODEL=gemini-flash-latest
AI_API_KEY=your-ai-api-key
SUPABASE_STORAGE_BUCKET_CHAT_UPLOADS=chat-uploads
CHAT_IMAGE_MAX_BYTES=5242880
CHAT_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp
AUTH_SECRET=replace-with-strong-secret
AUTH_COOKIE_NAME=afalambe_session
AUTH_COOKIE_SECURE=false
# Set to true to enforce auth rate limits locally (default: off when NODE_ENV is not production)
# RATE_LIMIT_DISABLED=false
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=hello@afalambe.org
RESEND_WEBHOOK_SIGNING_SECRET=your-webhook-secret
